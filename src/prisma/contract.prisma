// use prisma-8
model User {
  id        String               @id @default(cuid(2))
  email     String               @unique
  name      String?
  password  String
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()
  tickets   Ticket[]
}

model Ticket {
  id          Int                  @id @default(autoincrement())
  subject     String
  description String
  priority    String
  status      String               @default("Open")
  createdAt   DateTime             @default(now())
  updatedAt   temporal.updatedAt()
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
}
